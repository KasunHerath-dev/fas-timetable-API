# MongoDB Atlas Configuration Example
# Connection URI for MongoDB Atlas cluster
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/fas_timetable?retryWrites=true&w=majority

# Target Database name (default: fas_timetable)
MONGODB_DATABASE=fas_timetable

# Optional separate credentials if not included in URI
MONGODB_USERNAME=
MONGODB_PASSWORD=
